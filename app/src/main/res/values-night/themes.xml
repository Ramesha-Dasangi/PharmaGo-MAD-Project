<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for Night mode -->
    <style name="Theme.PharmaGoMADProject" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/pg_primary</item>
        <item name="colorPrimaryVariant">@color/pg_primary_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/pg_accent</item>
        <item name="colorSecondaryVariant">@color/pg_accent</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/pg_primary</item>
        <item name="android:windowBackground">@color/pg_bg</item>
    </style>
</resources>