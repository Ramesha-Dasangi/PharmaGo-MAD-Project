<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rounded_white"
    android:layout_marginTop="12dp"
    android:padding="16dp"
    android:elevation="2dp">

    <TextView
        android:id="@+id/tvStopNum"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:text="1"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/light_green_text"
        android:background="@color/light_green_bg"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvStopName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Pharmacy"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/tvStopNum"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvStopItems"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Items"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="@id/tvStopName"
        app:layout_constraintTop_toBottomOf="@id/tvStopName" />

    <ImageView
        android:id="@+id/btnExpandStop"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvStopName"
        app:layout_constraintBottom_toBottomOf="@id/tvStopItems" />

    <LinearLayout
        android:id="@+id/layoutStopDetails"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="@id/tvStopName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvStopItems">

        <TextView
            android:id="@+id/tvStopAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading..."
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tvStopPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading..."
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
