<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <View
        android:id="@+id/topBackground"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@color/colorPrimary"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_arrow_back"
        app:tint="@color/white"
        android:layout_marginTop="56dp"
        android:layout_marginStart="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Complaints"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/ivBack"
        app:layout_constraintTop_toTopOf="@id/ivBack"
        app:layout_constraintBottom_toBottomOf="@id/ivBack" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBackground"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Tab bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/rounded_edittext"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tabOpen"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Open (3)"
                    android:textColor="@color/white"
                    android:background="@drawable/tab_active_bg"
                    android:paddingVertical="12dp"
                    android:gravity="center"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabResolved"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Resolved"
                    android:textColor="@color/colorTextSecondary"
                    android:paddingVertical="12dp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- OPEN COMPLAINTS -->
            <LinearLayout
                android:id="@+id/llOpen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Open Card 1 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <TextView android:id="@+id/tvTitle1" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:text="Wrong medicine" android:textColor="@color/black" android:textSize="16sp" android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toStartOf="@id/tvStatus1" />

                        <TextView android:id="@+id/tvStatus1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="High" android:textColor="@color/colorRed" android:background="@drawable/bg_warning_red"
                            android:paddingHorizontal="12dp" android:paddingVertical="4dp" android:textSize="12sp" android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />

                        <TextView android:id="@+id/tvDetails1a" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:text="By: Buddhini · Order #PG-00234" android:textColor="@color/colorTextSecondary" android:textSize="12sp"
                            android:layout_marginTop="8dp"
                            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tvTitle1" />

                        <TextView android:id="@+id/tvDetails1b" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:text="Against: MediCare Pharmacy" android:textColor="@color/colorTextSecondary" android:textSize="12sp"
                            android:layout_marginTop="4dp"
                            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tvDetails1a" />

                        <com.google.android.material.button.MaterialButton android:id="@+id/btnView1"
                            android:layout_width="0dp" android:layout_height="56dp"
                            android:text="View details" android:textColor="@color/colorTextSecondary" android:textSize="14sp"
                            app:backgroundTint="@color/white" app:strokeWidth="1dp" app:strokeColor="@color/colorStroke" app:cornerRadius="12dp"
                            android:layout_marginTop="16dp" android:layout_marginEnd="8dp"
                            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/btnAction1"
                            app:layout_constraintTop_toBottomOf="@id/tvDetails1b" />

                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAction1"
                            android:layout_width="wrap_content" android:layout_height="56dp"
                            android:text="Suspend" android:textColor="@color/white" android:textSize="14sp"
                            app:backgroundTint="@color/colorRed" app:cornerRadius="12dp"
                            android:layout_marginTop="16dp"
                            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/tvDetails1b" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Open Card 2 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <TextView android:id="@+id/tvTitle2" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:text="Rider unresponsive" android:textColor="@color/black" android:textSize="16sp" android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toStartOf="@id/tvStatus2" />

                        <TextView android:id="@+id/tvStatus2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Medium" android:textColor="#F57C00" android:background="@drawable/status_pending_bg"
                            android:paddingHorizontal="12dp" android:paddingVertical="4dp" android:textSize="12sp" android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />

                        <TextView android:id="@+id/tvDetails2a" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:text="By: Saman · Order #PG-00198" android:textColor="@color/colorTextSecondary" android:textSize="12sp"
                            android:layout_marginTop="8dp"
                            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tvTitle2" />

                        <TextView android:id="@+id/tvDetails2b" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:text="Against: Nuwan F. (rider)" android:textColor="@color/colorTextSecondary" android:textSize="12sp"
                            android:layout_marginTop="4dp"
                            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tvDetails2a" />

                        <com.google.android.material.button.MaterialButton android:id="@+id/btnView2"
                            android:layout_width="0dp" android:layout_height="56dp"
                            android:text="View" android:textColor="@color/colorTextSecondary" android:textSize="14sp"
                            app:backgroundTint="@color/white" app:strokeWidth="1dp" app:strokeColor="@color/colorStroke" app:cornerRadius="12dp"
                            android:layout_marginTop="16dp" android:layout_marginEnd="8dp"
                            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/btnAction2"
                            app:layout_constraintTop_toBottomOf="@id/tvDetails2b" />

                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAction2"
                            android:layout_width="wrap_content" android:layout_height="56dp"
                            android:text="Warn rider" android:textColor="#F57C00" android:textSize="14sp"
                            app:backgroundTint="#FFF3E0" app:cornerRadius="12dp"
                            android:layout_marginTop="16dp"
                            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/tvDetails2b" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Open Card 3 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <TextView android:id="@+id/tvTitle3" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:text="Late delivery" android:textColor="@color/black" android:textSize="16sp" android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toStartOf="@id/tvStatus3" />

                        <TextView android:id="@+id/tvStatus3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Low" android:textColor="@color/colorBlue" android:background="@drawable/icon_bg_blue"
                            android:paddingHorizontal="12dp" android:paddingVertical="4dp" android:textSize="12sp" android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />

                        <TextView android:id="@+id/tvDetails3a" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:text="By: Priya · Order #PG-00312" android:textColor="@color/colorTextSecondary" android:textSize="12sp"
                            android:layout_marginTop="8dp"
                            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tvTitle3" />

                        <TextView android:id="@+id/tvDetails3b" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:text="Against: Kamal S. (rider)" android:textColor="@color/colorTextSecondary" android:textSize="12sp"
                            android:layout_marginTop="4dp"
                            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tvDetails3a" />

                        <com.google.android.material.button.MaterialButton android:id="@+id/btnView3"
                            android:layout_width="0dp" android:layout_height="56dp"
                            android:text="View" android:textColor="@color/colorTextSecondary" android:textSize="14sp"
                            app:backgroundTint="@color/white" app:strokeWidth="1dp" app:strokeColor="@color/colorStroke" app:cornerRadius="12dp"
                            android:layout_marginTop="16dp" android:layout_marginEnd="8dp"
                            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/btnAction3"
                            app:layout_constraintTop_toBottomOf="@id/tvDetails3b" />

                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAction3"
                            android:layout_width="wrap_content" android:layout_height="56dp"
                            android:text="Resolve" android:textColor="@color/colorAccent" android:textSize="14sp"
                            app:backgroundTint="#E8F5E9" app:cornerRadius="12dp"
                            android:layout_marginTop="16dp"
                            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/tvDetails3b" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- RESOLVED COMPLAINTS -->
            <LinearLayout
                android:id="@+id/llResolved"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Resolved Card 1 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <TextView android:id="@+id/tvRTitle1" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:text="Incorrect prescription" android:textColor="@color/black" android:textSize="16sp" android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toStartOf="@id/tvRStatus1" />

                        <TextView android:id="@+id/tvRStatus1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Resolved" android:textColor="@color/colorAccent" android:background="@drawable/bg_badge_green"
                            android:paddingHorizontal="12dp" android:paddingVertical="4dp" android:textSize="12sp" android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />

                        <TextView android:id="@+id/tvRDetails1a" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:text="By: Nimal · Order #PG-00154" android:textColor="@color/colorTextSecondary" android:textSize="12sp"
                            android:layout_marginTop="8dp"
                            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tvRTitle1" />

                        <TextView android:id="@+id/tvRDetails1b" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:text="Against: Wellness Pharmacy · Resolved 3 days ago"
                            android:textColor="@color/colorTextSecondary" android:textSize="12sp" android:layout_marginTop="4dp"
                            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tvRDetails1a" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Resolved Card 2 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <TextView android:id="@+id/tvRTitle2" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:text="Rude rider behaviour" android:textColor="@color/black" android:textSize="16sp" android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toStartOf="@id/tvRStatus2" />

                        <TextView android:id="@+id/tvRStatus2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Resolved" android:textColor="@color/colorAccent" android:background="@drawable/bg_badge_green"
                            android:paddingHorizontal="12dp" android:paddingVertical="4dp" android:textSize="12sp" android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />

                        <TextView android:id="@+id/tvRDetails2a" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:text="By: Amara · Order #PG-00098" android:textColor="@color/colorTextSecondary" android:textSize="12sp"
                            android:layout_marginTop="8dp"
                            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tvRTitle2" />

                        <TextView android:id="@+id/tvRDetails2b" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:text="Against: Sahan J. (rider) · Resolved 1 week ago"
                            android:textColor="@color/colorTextSecondary" android:textSize="12sp" android:layout_marginTop="4dp"
                            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tvRDetails2a" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Resolved Card 3 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <TextView android:id="@+id/tvRTitle3" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:text="Expired medicine delivered" android:textColor="@color/black" android:textSize="16sp" android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toStartOf="@id/tvRStatus3" />

                        <TextView android:id="@+id/tvRStatus3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Resolved" android:textColor="@color/colorAccent" android:background="@drawable/bg_badge_green"
                            android:paddingHorizontal="12dp" android:paddingVertical="4dp" android:textSize="12sp" android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />

                        <TextView android:id="@+id/tvRDetails3a" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:text="By: Chamara · Order #PG-00063" android:textColor="@color/colorTextSecondary" android:textSize="12sp"
                            android:layout_marginTop="8dp"
                            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tvRTitle3" />

                        <TextView android:id="@+id/tvRDetails3b" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:text="Against: City Pharma Express · Resolved 2 weeks ago"
                            android:textColor="@color/colorTextSecondary" android:textSize="12sp" android:layout_marginTop="4dp"
                            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tvRDetails3a" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingVertical="8dp"
        app:itemIconTint="@color/nav_icon_color"
        app:itemTextColor="@color/nav_icon_color"
        app:itemBackground="@drawable/nav_item_bg"
        app:itemRippleColor="@android:color/transparent"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/admin_bottom_nav"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
