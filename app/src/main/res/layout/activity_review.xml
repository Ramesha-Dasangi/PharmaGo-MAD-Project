<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pg_bg">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/pg_primary"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:paddingTop="40dp"
        android:paddingBottom="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            app:tint="@android:color/white"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Rate your experience"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/reviewRootContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Order info -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/pg_card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <TextView
                        android:id="@+id/tvOrderHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Order #PG-00234"
                        android:textColor="@color/pg_text"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Delivered successfully"
                        android:textColor="@color/pg_primary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Rate pharmacy -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPharmacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/pg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_pharmacy_icon"
                            android:layout_marginEnd="10dp">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_store"
                                android:contentDescription="@null"
                                app:tint="@color/pg_primary" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvPharmacyRateLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rate MediCare Pharmacy"
                                android:textColor="@color/pg_text"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif-medium" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Medicine quality, packaging..."
                                android:textColor="@color/pg_sub"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Star rating — pharmacy -->
                    <LinearLayout
                        android:id="@+id/starsPharmacy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <TextView android:id="@+id/starP1" android:layout_width="36dp"
                            android:layout_height="36dp" android:gravity="center"
                            android:text="☆" android:textSize="28sp" android:textColor="#FCD34D"
                            android:clickable="true" android:focusable="true" />
                        <TextView android:id="@+id/starP2" android:layout_width="36dp"
                            android:layout_height="36dp" android:gravity="center"
                            android:text="☆" android:textSize="28sp" android:textColor="#FCD34D"
                            android:clickable="true" android:focusable="true" />
                        <TextView android:id="@+id/starP3" android:layout_width="36dp"
                            android:layout_height="36dp" android:gravity="center"
                            android:text="☆" android:textSize="28sp" android:textColor="#FCD34D"
                            android:clickable="true" android:focusable="true" />
                        <TextView android:id="@+id/starP4" android:layout_width="36dp"
                            android:layout_height="36dp" android:gravity="center"
                            android:text="☆" android:textSize="28sp" android:textColor="#FCD34D"
                            android:clickable="true" android:focusable="true" />
                        <TextView android:id="@+id/starP5" android:layout_width="36dp"
                            android:layout_height="36dp" android:gravity="center"
                            android:text="☆" android:textSize="28sp" android:textColor="#FCD34D"
                            android:clickable="true" android:focusable="true" />

                    </LinearLayout>

                    <!-- Comment — pharmacy -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintEnabled="false"
                        app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                        app:boxStrokeColor="@color/pg_border">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPharmacyComment"
                            android:layout_width="match_parent"
                            android:layout_height="80dp"
                            android:gravity="top"
                            android:hint="Share your experience with this pharmacy..."
                            android:inputType="textMultiLine"
                            android:textSize="13sp"
                            android:textColor="@color/pg_text"
                            android:textColorHint="@color/pg_sub" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Container for extra pharmacy rating cards (multi-pharmacy orders) -->
            <LinearLayout
                android:id="@+id/extraPharmacyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Rate rider -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardRider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/pg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_medicine_icon"
                            android:layout_marginEnd="10dp">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_person"
                                android:contentDescription="@null"
                                app:tint="@color/pg_primary" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvRiderRateLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rate Kamal — your rider"
                                android:textColor="@color/pg_text"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif-medium" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Delivery speed, behavior..."
                                android:textColor="@color/pg_sub"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Star rating — rider -->
                    <LinearLayout
                        android:id="@+id/starsRider"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <TextView android:id="@+id/starR1" android:layout_width="36dp"
                            android:layout_height="36dp" android:gravity="center"
                            android:text="☆" android:textSize="28sp" android:textColor="#FCD34D"
                            android:clickable="true" android:focusable="true" />
                        <TextView android:id="@+id/starR2" android:layout_width="36dp"
                            android:layout_height="36dp" android:gravity="center"
                            android:text="☆" android:textSize="28sp" android:textColor="#FCD34D"
                            android:clickable="true" android:focusable="true" />
                        <TextView android:id="@+id/starR3" android:layout_width="36dp"
                            android:layout_height="36dp" android:gravity="center"
                            android:text="☆" android:textSize="28sp" android:textColor="#FCD34D"
                            android:clickable="true" android:focusable="true" />
                        <TextView android:id="@+id/starR4" android:layout_width="36dp"
                            android:layout_height="36dp" android:gravity="center"
                            android:text="☆" android:textSize="28sp" android:textColor="#FCD34D"
                            android:clickable="true" android:focusable="true" />
                        <TextView android:id="@+id/starR5" android:layout_width="36dp"
                            android:layout_height="36dp" android:gravity="center"
                            android:text="☆" android:textSize="28sp" android:textColor="#FCD34D"
                            android:clickable="true" android:focusable="true" />

                    </LinearLayout>

                    <!-- Comment — rider -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintEnabled="false"
                        app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                        app:boxStrokeColor="@color/pg_border">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRiderComment"
                            android:layout_width="match_parent"
                            android:layout_height="80dp"
                            android:gravity="top"
                            android:hint="How was your delivery experience?"
                            android:inputType="textMultiLine"
                            android:textSize="13sp"
                            android:textColor="@color/pg_text"
                            android:textColorHint="@color/pg_sub" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Submit button -->
    <LinearLayout
        android:id="@+id/bottomCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/pg_card"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitReview"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Submit review"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="12dp"
            android:backgroundTint="@color/pg_primary"
            android:textColor="@android:color/white" />

        <!-- Skip button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSkipReview"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Skip"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:strokeColor="@color/pg_border"
            android:textColor="@color/pg_sub"
            app:cornerRadius="12dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
