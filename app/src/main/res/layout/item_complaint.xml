<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="5dp">


    <androidx.constraintlayout.widget.ConstraintLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Target Name -->

        <TextView
            android:id="@+id/tvTargetName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Pharmacy Name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/pg_text"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>


        <!-- Complaint Type -->

        <TextView
            android:id="@+id/tvComplaintType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pharmacy"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/pg_primary"

            android:layout_marginTop="8dp"

            app:layout_constraintTop_toBottomOf="@id/tvTargetName"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Order ID -->
        <TextView
            android:id="@+id/tvOrderId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Order #1234"
            android:textSize="14sp"
            android:textColor="@color/pg_sub"
            android:layout_marginStart="16dp"

            app:layout_constraintTop_toTopOf="@id/tvComplaintType"
            app:layout_constraintBottom_toBottomOf="@id/tvComplaintType"
            app:layout_constraintStart_toEndOf="@id/tvComplaintType"/>


        <!-- Reason -->

        <TextView
            android:id="@+id/tvReason"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Reason"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/pg_text"

            android:layout_marginTop="10dp"

            app:layout_constraintTop_toBottomOf="@id/tvComplaintType"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>


        <!-- Description -->

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textSize="14sp"
            android:textColor="@color/pg_text"

            android:layout_marginTop="8dp"

            app:layout_constraintTop_toBottomOf="@id/tvReason"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>


        <!-- Status -->

        <TextView
            android:id="@+id/tvComplaintStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pending"
            android:textSize="14sp"
            android:textStyle="bold"

            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"

            android:layout_marginTop="12dp"

            android:background="@drawable/bg_tag_green"

            app:layout_constraintTop_toBottomOf="@id/tvDescription"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Resolve Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResolve"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resolve"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:backgroundTint="@color/pg_text"
            app:cornerRadius="12dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDescription"
            app:layout_constraintBottom_toBottomOf="parent"/>


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>