<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".customer.RegisterPharmacyActivity">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/pg_primary"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="40dp"
        android:paddingBottom="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            app:tint="@android:color/white"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Create account"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/formCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="-16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/pg_card"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Role selector -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="I AM A"
                    android:textColor="@color/pg_sub"
                    android:textSize="11sp"
                    android:letterSpacing="0.05"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp"
                    android:weightSum="3">

                    <TextView
                        android:id="@+id/roleCustomer"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Customer"
                        android:textSize="12sp"
                        android:textColor="@color/pg_sub"
                        android:background="@drawable/bg_role_unselected"
                        android:layout_marginEnd="6dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/rolePharmacy"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Pharmacy"
                        android:textSize="12sp"
                        android:textColor="@color/pg_primary"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/bg_role_selected"
                        android:layout_marginEnd="6dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/roleRider"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Rider"
                        android:textSize="12sp"
                        android:textColor="@color/pg_sub"
                        android:background="@drawable/bg_role_unselected"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <!-- Pharmacy name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PHARMACY NAME"
                    android:textColor="@color/pg_sub"
                    android:textSize="11sp"
                    android:letterSpacing="0.05"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="4dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false"
                    app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="@color/pg_border"
                    app:startIconDrawable="@drawable/ic_store"
                    app:startIconTint="@color/pg_sub"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPharmacyName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="MediCare Pharmacy"
                        android:textSize="14sp"
                        android:textColor="@color/pg_text"
                        android:textColorHint="@color/pg_sub" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Owner full name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OWNER FULL NAME"
                    android:textColor="@color/pg_sub"
                    android:textSize="11sp"
                    android:letterSpacing="0.05"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="4dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false"
                    app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="@color/pg_border"
                    app:startIconDrawable="@drawable/ic_person"
                    app:startIconTint="@color/pg_sub"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOwnerName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nimal Silva"
                        android:textSize="14sp"
                        android:textColor="@color/pg_text"
                        android:textColorHint="@color/pg_sub" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Business reg / license -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BUSINESS REGISTRATION / LICENSE NO."
                    android:textColor="@color/pg_sub"
                    android:textSize="11sp"
                    android:letterSpacing="0.05"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="4dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false"
                    app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="@color/pg_border"
                    app:startIconDrawable="@drawable/ic_id"
                    app:startIconTint="@color/pg_sub"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLicenseNo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="PHM-2024-00891"
                        android:textSize="14sp"
                        android:textColor="@color/pg_text"
                        android:textColorHint="@color/pg_sub" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Email -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EMAIL"
                    android:textColor="@color/pg_sub"
                    android:textSize="11sp"
                    android:letterSpacing="0.05"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="4dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false"
                    app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="@color/pg_border"
                    app:startIconDrawable="@drawable/ic_email"
                    app:startIconTint="@color/pg_sub"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="medicare@gmail.com"
                        android:inputType="textEmailAddress"
                        android:textSize="14sp"
                        android:textColor="@color/pg_text"
                        android:textColorHint="@color/pg_sub" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Phone -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PHONE"
                    android:textColor="@color/pg_sub"
                    android:textSize="11sp"
                    android:letterSpacing="0.05"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="4dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false"
                    app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="@color/pg_border"
                    app:startIconDrawable="@drawable/ic_phone"
                    app:startIconTint="@color/pg_sub"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="011 234 5678"
                        android:inputType="phone"
                        android:textSize="14sp"
                        android:textColor="@color/pg_text"
                        android:textColorHint="@color/pg_sub" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Pharmacy address -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PHARMACY ADDRESS"
                    android:textColor="@color/pg_sub"
                    android:textSize="11sp"
                    android:letterSpacing="0.05"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="4dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false"
                    app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="@color/pg_border"
                    app:startIconDrawable="@drawable/ic_location"
                    app:startIconTint="@color/pg_sub"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="No. 12, Galle Road, Colombo 3"
                        android:textSize="14sp"
                        android:textColor="@color/pg_text"
                        android:textColorHint="@color/pg_sub" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Upload license -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UPLOAD LICENSE / CERTIFICATE"
                    android:textColor="@color/pg_sub"
                    android:textSize="11sp"
                    android:letterSpacing="0.05"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:id="@+id/uploadLicenseArea"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_upload_area"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to upload PDF / image"
                        android:textColor="@color/pg_sub"
                        android:textSize="12sp" />
3
                </LinearLayout>

                <!-- Submit button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitForApproval"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Submit for approval"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    app:cornerRadius="10dp"
                    android:backgroundTint="@color/pg_primary"
                    android:textColor="@android:color/white" />

                <!-- Already have account -->
                <TextView
                    android:id="@+id/tvLogin"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Already have an account? Log in"
                    android:textSize="12sp"
                    android:textColor="@color/pg_sub"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground" />

            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>