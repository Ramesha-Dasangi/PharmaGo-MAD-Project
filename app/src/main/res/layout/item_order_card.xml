<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"

    app:cardCornerRadius="16dp"
    app:cardElevation="5dp">


    <androidx.constraintlayout.widget.ConstraintLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">


        <!-- Order ID -->

        <TextView
            android:id="@+id/tvOrderId"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="#ORDER1234"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/pg_text"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>



        <!-- Status -->

        <TextView
            android:id="@+id/tvStatus"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Pending"

            android:textSize="14sp"
            android:textStyle="bold"

            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"

            android:background="@drawable/bg_tag_green"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>



        <!-- Pharmacy -->

        <TextView
            android:id="@+id/tvPharmacy"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:text="Pharmacy Name"

            android:textSize="15sp"
            android:textColor="@color/pg_text"

            android:layout_marginTop="12dp"

            app:layout_constraintTop_toBottomOf="@id/tvOrderId"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>



        <!-- Total -->

        <TextView
            android:id="@+id/tvTotal"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Rs. 1000"

            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/pg_primary"

            android:layout_marginTop="10dp"

            app:layout_constraintTop_toBottomOf="@id/tvPharmacy"
            app:layout_constraintStart_toStartOf="parent"/>



        <!-- Buttons Layout -->

        <LinearLayout

            android:id="@+id/orderButtonsLayout"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"
            android:gravity="center"

            android:layout_marginTop="15dp"

            app:layout_constraintTop_toBottomOf="@id/tvTotal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <TextView
                android:id="@+id/btnTrackOrder"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:gravity="center"

                android:text="Track"

                android:textSize="13sp"
                android:textStyle="bold"

                android:padding="10dp"

                android:background="@drawable/bg_button_primary"/>



            <TextView
                android:id="@+id/btnCancelOrder"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:gravity="center"

                android:text="Cancel"

                android:textSize="13sp"
                android:textStyle="bold"

                android:padding="10dp"

                android:layout_marginStart="6dp"

                android:background="@drawable/bg_button_red"/>



            <TextView
                android:id="@+id/btnReorder1"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:gravity="center"

                android:text="Reorder"

                android:textSize="13sp"
                android:textStyle="bold"

                android:padding="10dp"

                android:layout_marginStart="6dp"

                android:background="@drawable/bg_button_primary"/>



            <TextView
                android:id="@+id/btnReport1"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:gravity="center"

                android:text="Report"

                android:textSize="13sp"
                android:textStyle="bold"

                android:padding="10dp"

                android:layout_marginStart="6dp"

                android:background="@drawable/bg_button_red"/>


        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.cardview.widget.CardView>