<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pg_bg"
    tools:context=".customer.activities.order.OrderTrackingActivity">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/pg_primary"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="40dp"
        android:paddingBottom="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            app:tint="@android:color/white"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Track order"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!--  Order summary card  -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/pg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:id="@+id/tvOrderNumber"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Order #..."
                            android:textColor="@color/pg_text"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium"/>
                        <TextView
                            android:id="@+id/tvOrderBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pending"
                            android:textSize="10sp"
                            android:textColor="#1E40AF"
                            android:fontFamily="sans-serif-medium"
                            android:background="@drawable/bg_tag_blue"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvOrderSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Loading order details..."
                        android:textColor="@color/pg_sub"
                        android:textSize="11sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!--  Delivery progress label  -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delivery progress"
                android:textColor="@color/pg_text"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="12dp"/>

            <!-- Current status text -->
            <TextView
                android:id="@+id/tvCurrentStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Current status"
                android:textColor="@color/pg_text"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="12dp"/>


            <!--  Step 1: Order Placed (Always Done with Green Tick)  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="2dp">
                <FrameLayout
                    android:id="@+id/indicatorStep1"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_step_done">
                    <ImageView
                        android:id="@+id/iconStep1"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check"
                        android:contentDescription="@null"
                        app:tint="@color/pg_primary"/>
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp"
                    android:paddingBottom="14dp">
                    <TextView
                        android:id="@+id/tvStep1Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Order Placed"
                        android:textColor="@color/pg_text"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"/>
                    <TextView
                        android:id="@+id/tvStep1Time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Waiting for pharmacy confirmation"
                        android:textColor="@color/pg_sub"
                        android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>

            <!--  Step 2: Order Confirmed / Preparing  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="2dp">
                <FrameLayout
                    android:id="@+id/indicatorStep2"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_step_pending">
                    <ImageView
                        android:id="@+id/iconStep2"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check"
                        android:contentDescription="@null"
                        app:tint="@color/pg_primary"/>
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp"
                    android:paddingBottom="14dp">
                    <TextView
                        android:id="@+id/tvStep2Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pharmacy Confirmation"
                        android:textColor="@color/pg_text"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"/>
                    <TextView
                        android:id="@+id/tvStep2Sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pending"
                        android:textColor="@color/pg_sub"
                        android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>

            <!--  Step 3: Picked up by Rider  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="2dp">
                <FrameLayout
                    android:id="@+id/indicatorStep3"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_step_pending">
                    <ImageView
                        android:id="@+id/iconStep3"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check"
                        android:contentDescription="@null"
                        app:tint="@color/pg_primary"/>
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp"
                    android:paddingBottom="14dp">
                    <TextView
                        android:id="@+id/tvStep3Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Picked up by Rider"
                        android:textColor="@color/pg_text"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"/>
                    <TextView
                        android:id="@+id/tvStep3Sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pending"
                        android:textColor="@color/pg_sub"
                        android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>

            <!--  Step 4: Out for delivery  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="2dp">
                <FrameLayout
                    android:id="@+id/indicatorStep4"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_step_pending">
                    <ImageView
                        android:id="@+id/iconStep4"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_bike"
                        android:contentDescription="@null"
                        app:tint="@android:color/white"/>
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp"
                    android:paddingBottom="14dp">
                    <TextView
                        android:id="@+id/tvStep4Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Out for Delivery"
                        android:textColor="@color/pg_text"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"/>
                    <TextView
                        android:id="@+id/tvStep4Sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pending"
                        android:textColor="@color/pg_sub"
                        android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>

            <!--  Step 5: Delivered  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">
                <FrameLayout
                    android:id="@+id/indicatorStep5"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_step_pending">
                    <ImageView
                        android:id="@+id/iconStep5"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check"
                        android:contentDescription="@null"
                        app:tint="@android:color/white"
                        android:visibility="gone"/>
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">
                    <TextView
                        android:id="@+id/tvStep5Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Delivered"
                        android:textColor="@color/pg_sub"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/tvStep5Sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pending"
                        android:textColor="@color/pg_sub"
                        android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>

            <!--  Rider card  -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardRider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/pg_card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">
                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_medicine_icon"
                        android:layout_marginEnd="10dp">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_person"
                            android:contentDescription="@null"
                            app:tint="@color/pg_primary"/>
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvRiderName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Assigning rider..."
                            android:textColor="@color/pg_text"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-medium"/>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="2dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⭐ 4.9"
                                android:textColor="@color/pg_sub"
                                android:textSize="11sp"/>
                        </LinearLayout>
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/btnCallRider"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_phone"
                        android:contentDescription="Call rider"
                        app:tint="@color/pg_primary"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!--  Report issue button  -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReportIssue"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Report an issue with this order"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:cornerRadius="10dp"
                app:strokeColor="#EF4444"
                android:textColor="#EF4444"/>

            <!-- Leave review button (hidden until delivered) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLeaveReview"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Leave a review"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:cornerRadius="10dp"
                android:textColor="@color/pg_primary"
                android:visibility="visible" />
<!--                android:visibility="gone"/>-->

            <!--development testing -->

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>