<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="6dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Paracetamol 500mg"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#222222" />

            <TextView
                android:id="@+id/txtLowStock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOW STOCK"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@android:color/holo_orange_dark"
                android:background="@drawable/bg_low_stock"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" />

        </LinearLayout>

        <!-- Category -->
        <TextView
            android:id="@+id/txtCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Pain Relief"
            android:textSize="13sp"
            android:textColor="#777777" />

        <!-- Stock -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtStock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stock : 5"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#E53935" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="   |   "
                android:textColor="#999999" />

            <TextView
                android:id="@+id/txtReorderLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reorder Level : 20"
                android:textSize="14sp"
                android:textColor="#555555" />

        </LinearLayout>

        <!-- Price -->
        <TextView
            android:id="@+id/txtPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Price : Rs.250"
            android:textSize="13sp"
            android:textColor="#888888" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnReorder"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="REORDER"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:backgroundTint="#00A86B" />


        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>