<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ================= PERMISSIONS ================= -->

    <!-- Camera -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Android 13+ -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Android 12 and below -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Optional -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PharmaGoMADProject"
        tools:targetApi="31">

        <!-- ================= PROFILE ================= -->

        <activity
            android:name=".pharmacyowner.profile.ForgotPasswordActivity"
            android:exported="false" />

        <activity
            android:name=".pharmacyowner.profile.ChangePasswordActivity"
            android:exported="false" />

        <!-- ================= INVENTORY ================= -->

        <activity
            android:name=".pharmacyowner.InventoryActivity"
            android:exported="false" />

        <activity
            android:name=".pharmacyowner.inventory.AddMedicineActivity"
            android:exported="false" />

        <activity
            android:name=".pharmacyowner.inventory.EditMedicineActivity"
            android:exported="false" />

        <activity
            android:name=".pharmacyowner.inventory.DeleteMedicineActivity"
            android:exported="false" />

        <activity
            android:name=".pharmacyowner.inventory.LowStockActivity"
            android:exported="false" />

        <!-- ================= ORDERS ================= -->

        <activity
            android:name=".pharmacyowner.OrdersActivity"
            android:exported="false" />

        <activity
            android:name=".pharmacyowner.OrderDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".pharmacyowner.VerifyPrescriptionActivity"
            android:exported="false" />

        <activity
            android:name=".pharmacyowner.ApprovalSuccessActivity"
            android:exported="false" />

        <!-- ================= NOTIFICATIONS ================= -->

        <activity
            android:name=".pharmacyowner.NotificationsActivity"
            android:exported="false" />

        <!-- ================= REPORTS ================= -->

        <activity
            android:name=".pharmacyowner.reports.SalesReportActivity"
            android:exported="false" />

        <!-- ================= PROFILE ================= -->

        <activity
            android:name=".pharmacyowner.profile.ProfileActivity"
            android:exported="false" />

        <!-- ================= CUSTOMER ================= -->

        <activity
            android:name=".customer.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".customer.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".customer.HomeActivity"
            android:exported="false" />

        <activity
            android:name=".customer.MedicineDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".customer.CartActivity"
            android:exported="false" />

        <!-- ================= MAIN ================= -->

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- ================= LAUNCHER ================= -->

        <activity
            android:name=".pharmacyowner.DashboardActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>